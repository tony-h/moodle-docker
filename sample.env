# Generate random keys using: https://randomkeygen.com/
# Or using the teminal command: `pwgen -s 32 2`

# Database Credentials
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=moodle
MYSQL_USER=moodle_user
MYSQL_PASSWORD=your_moodle_db_password

# Site Identification
SITE_LABEL=moodle-name
DOMAIN=moodle.example.com

# Moodle Site Information
MOODLE_SITE_FULLNAME="Your Moodle Site Full Name"
MOODLE_SITE_SHORTNAME="Your Moodle Site Short Name"
MOODLE_SITE_SUMMARY="A brief summary of your Moodle site"

# Moodle Admin Credentials
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=your_secure_admin_password
MOODLE_ADMIN_EMAIL=your_admin_email@example.com
MOODLE_NOREPLY_EMAIL=your_noreply_email@example.com